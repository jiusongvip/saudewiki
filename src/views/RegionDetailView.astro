---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BodyMap from '../components/BodyMap.astro';
import DiseaseCard from '../components/DiseaseCard.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { fill, localeSpecs } from '../lib/i18n';
import { contentFor, formatDateFor } from '../lib/content';
import { unitCount } from '../lib/counts';
import type { BodyRegion, Locale } from '../types';

interface Props {
  lang: Locale;
  region: BodyRegion;
}

const { lang, region } = Astro.props;
const t = ui[lang];
const c = contentFor(lang);

const diseases = c.regionDiseases(region);
const articles = c.regionArticles(region);
const counts = c.regionCounts(region);
const isEmpty = counts.total === 0;
const worldProse = region.globalOverview ?? [];
const lusophoneProse = region.lusophoneOverview ?? [];
const hasProse = worldProse.length > 0 || lusophoneProse.length > 0;

const breadcrumbs = [
  { name: t.common.home, href: c.urls.home() },
  { name: t.nav.regions, href: c.urls.regions() },
  { name: region.name, href: c.urls.region(region.slug) },
];

const name = region.name.toLowerCase();
const metaDescription =
  isEmpty && !hasProse ? fill(t.regionPage.emptyMeta, { region: region.name }) : region.description;
const pageId = `${SITE.url}${c.urls.region(region.slug)}`;

const schemaNodes: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageId}#page`,
    name: region.name,
    description: region.description,
    inLanguage: localeSpecs[lang].hreflang,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
];

if (diseases.length > 0) {
  schemaNodes.push({
    '@type': 'ItemList',
    '@id': `${pageId}#lista`,
    name: fill(t.regionPage.itemListName, { region: name }),
    itemListElement: diseases.map((disease, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: disease.name,
      url: `${SITE.url}${c.urls.disease(disease.slug)}`,
    })),
  });
}
---

<BaseLayout
  lang={lang}
  title={`${fill(t.regionPage.titlePattern, { name: region.name })} | ${SITE.name}`}
  description={metaDescription}
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
>
  <div class="mx-auto max-w-6xl px-5 pt-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />
  </div>

  <!--
    One grid for the whole page rather than one per block. The plate is
    wayfinding, so it travels beside the text from the heading down to the last
    card instead of scrolling away after the first screen — and because the cards
    now live in the same column as the heading, they end where it ends.
    `items-start` is what makes the stickiness possible: the grid row is as tall
    as the content column, so the rail has the full page to move within.
  -->
  <div class="mx-auto grid max-w-6xl items-start gap-x-10 gap-y-10 px-5 pb-16 pt-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0">
      <h1 class="display text-[2.4rem] sm:text-[3.1rem]">{region.name}</h1>
      <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-ink-muted">{region.description}</p>

      <div class="mt-8 max-w-2xl">
        <MedicalDisclaimer lang={lang} />
      </div>

      {
        isEmpty && !hasProse ? (
          <aside class="mt-8 max-w-2xl rounded-xl border border-warn/30 bg-warn-soft p-5" role="note">
            <div class="flex gap-3">
              <Icon name="tabler:clock-hour-4" class="mt-0.5 h-4 w-4 shrink-0 text-warn" />
              <div class="text-[0.85rem] leading-relaxed">
                <p class="font-semibold">{t.common.inConstruction}</p>
                <p class="mt-1 text-ink-muted">{t.regionPage.emptyBody}</p>
                <p class="mt-2 text-ink-muted">
                  {t.regionPage.emptyInvite}{' '}
                  <a href={c.urls.contact()} class="font-semibold text-accent underline underline-offset-2">
                    {t.regionPage.talkToProject}
                  </a>
                </p>
              </div>
            </div>
          </aside>
        ) : isEmpty ? (
          <p class="mt-6 max-w-2xl text-[0.85rem] text-ink-muted">
            {t.regionPage.emptyInvite}{' '}
            <a href={c.urls.contact()} class="font-semibold text-accent underline underline-offset-2">
              {t.regionPage.talkToProject}
            </a>
          </p>
        ) : (
          <p class="mt-6 text-[0.85rem] font-semibold text-ink-muted">
            {fill(t.regionPage.countsHere, {
              diseases: unitCount(lang, counts.diseases, 'disease'),
              articles: unitCount(lang, counts.articles, 'article'),
            })}
          </p>
        )
      }

      {
        worldProse.length > 0 && (
          <section class="mt-12" aria-labelledby="pano-mundial">
            <h2 id="pano-mundial" class="display text-[1.8rem]">{t.regionPage.worldHeading}</h2>
            <div class="mt-5 max-w-2xl space-y-4 text-[0.98rem] leading-relaxed text-ink">
              {worldProse.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        )
      }

      {
        lusophoneProse.length > 0 && (
          <section class="mt-12" aria-labelledby="pano-lusofono">
            <h2 id="pano-lusofono" class="display text-[1.8rem]">{t.regionPage.lusophoneHeading}</h2>
            <div class="mt-5 max-w-2xl space-y-4 text-[0.98rem] leading-relaxed text-ink">
              {lusophoneProse.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        )
      }

      {
        diseases.length > 0 && (
          <section class="mt-14 border-t border-line pt-10" aria-labelledby="doencas-da-regiao">
            <h2 id="doencas-da-regiao" class="display text-[1.8rem]">
              {fill(t.regionPage.diseasesHere, { region: name })}
            </h2>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              {diseases.map((disease) => (
                <DiseaseCard lang={lang} disease={disease} />
              ))}
            </div>
          </section>
        )
      }

      {
        articles.length > 0 && (
          <section class="mt-14 rounded-2xl bg-surface p-6 sm:p-8" aria-labelledby="artigos-da-regiao">
            <h2 id="artigos-da-regiao" class="display text-[1.8rem]">{t.regionPage.articlesHere}</h2>
            <ul class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2">
              {articles.map((article) => (
                <li>
                  <a href={c.urls.article(article.slug)} class="group block">
                    <span class="text-[0.72rem] font-semibold uppercase tracking-wider text-accent">
                      {article.category}
                    </span>
                    <span class="mt-1.5 block text-[1.05rem] font-semibold leading-snug tracking-tight transition-colors group-hover:text-accent">
                      {article.title}
                    </span>
                    <span class="mt-1.5 block text-[0.78rem] text-ink-muted">
                      {fill(t.common.updatedOn, { date: formatDateFor(article.updatedAt, lang) })}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-14">
        <p class="max-w-2xl text-[0.85rem] leading-relaxed text-ink-muted">{t.regionPage.sourcesNote}</p>
        <a href={c.urls.regions()} class="mt-6 inline-flex items-center gap-2 text-[0.9rem] font-semibold text-accent">
          <Icon name="tabler:arrow-left" class="h-4 w-4" />
          {t.regionPage.allRegions}
        </a>
      </div>
    </div>

    <!-- The same figure the home page opens with, with this region's marker held
         open. It is wayfinding, not decoration: the reader learns where on the
         body they are, and the other markers stay clickable. -->
    <aside class="bodymap-rail order-first lg:order-none lg:sticky lg:top-20">
      <BodyMap lang={lang} regions={c.regions} activeSlug={region.slug} />
    </aside>
  </div>
</BaseLayout>
