---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import DiseaseCard from '../components/DiseaseCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GuideSections from '../components/GuideSections.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { contentFor, formatDateFor } from '../lib/content';
import { fill, localeSpecs } from '../lib/i18n';
import { unitCount } from '../lib/counts';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = contentFor(lang);

const categories = Array.from(
  new Map(c.diseases.map((d) => [d.categorySlug, d.category])).entries()
).map(([slug, label]) => ({ slug, label, count: c.diseases.filter((d) => d.categorySlug === slug).length }));

/**
 * The plain link list under the cards.
 *
 * Portuguese sorts by name because the heading says so; Chinese keeps the
 * editorial order, which is the only order a Chinese title has without a
 * romanisation table the site does not carry.
 */
const alphabetical =
  lang === 'pt-BR'
    ? [...c.diseases].sort((a, b) => a.name.localeCompare(b.name, 'pt', { sensitivity: 'base' }))
    : c.diseases;

/** Newest text in the collection, used as the freshness line under the lead. */
const latest = c.diseases.reduce((acc, disease) => (disease.updatedAt > acc ? disease.updatedAt : acc), '');

const breadcrumbs = [
  { name: t.common.home, href: c.urls.home() },
  { name: t.nav.diseases, href: c.urls.diseases() },
];

const pageId = `${SITE.url}${c.urls.diseases()}`;
const schemaNodes: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageId}#page`,
    name: t.diseasesIndex.h1,
    description: t.diseasesIndex.description,
    inLanguage: localeSpecs[lang].hreflang,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    '@id': `${pageId}#lista`,
    name: t.diseasesIndex.h1,
    numberOfItems: c.diseases.length,
    itemListElement: alphabetical.map((disease, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: disease.name,
      url: `${SITE.url}${c.urls.disease(disease.slug)}`,
    })),
  },
];
---

<BaseLayout lang={lang} title={`${t.diseasesIndex.title} | ${SITE.name}`} description={t.diseasesIndex.description} breadcrumbs={breadcrumbs} schemaNodes={schemaNodes}>
  <div class="mx-auto max-w-6xl px-5 pb-8 pt-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />

    <h1 class="display mt-6 text-[2.4rem] sm:text-[3.2rem]">{t.diseasesIndex.h1}</h1>
    <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-ink-muted">{t.diseasesIndex.lead}</p>
    {
      latest && (
        <p class="mt-3 text-[0.82rem] text-ink-muted">
          {fill(t.common.listUpdated, { date: formatDateFor(latest, lang) })}
        </p>
      )
    }

    <div class="mt-8 max-w-xl">
      <SearchBox lang={lang} variant="compact" />
    </div>

    <nav class="mt-8 flex flex-wrap gap-2.5" aria-label={t.diseasesIndex.groupHeading}>
      {
        categories.map((category) => (
          <a
            href={`#grupo-${category.slug}`}
            class="rounded-full border border-line px-3.5 py-1.5 text-[0.82rem] text-ink-muted transition-colors hover:border-accent hover:text-accent"
          >
            {category.label} <span class="tabular-nums opacity-70">({category.count})</span>
          </a>
        ))
      }
    </nav>
  </div>

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-2" aria-labelledby="lista-de-verbetes">
    <h2 id="lista-de-verbetes" class="display text-[1.8rem]">
      {t.diseasesIndex.listHeading}
    </h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {c.diseases.map((disease) => <DiseaseCard lang={lang} disease={disease} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-4" aria-labelledby="por-grupo">
    <h2 id="por-grupo" class="display text-[1.8rem]">
      {t.diseasesIndex.groupHeading}
    </h2>
    <p class="mt-4 max-w-2xl text-[0.98rem] leading-relaxed text-ink">{t.diseasesIndex.groupLead}</p>

    <div class="mt-10 flex flex-col gap-14">
      {
        categories.map((category) => {
          const inGroup = alphabetical.filter((disease) => disease.categorySlug === category.slug);
          return (
            <section aria-labelledby={`grupo-${category.slug}`}>
              <h3
                id={`grupo-${category.slug}`}
                class="scroll-mt-24 text-[1.25rem] font-extrabold tracking-tight"
              >
                {category.label}
                <span class="ml-2 text-[0.9rem] font-semibold text-ink-muted">
                  {unitCount(lang, inGroup.length, 'disease')}
                </span>
              </h3>
              <GuideSections lang={lang} sections={c.categoryGuide(category.slug)} class="mt-6" level={4} />
              <ul class="mt-6 flex flex-wrap gap-2">
                {inGroup.map((disease) => (
                  <li>
                    <a
                      href={c.urls.disease(disease.slug)}
                      class="inline-flex rounded-full border border-control bg-canvas px-3.5 py-1.5 text-[0.82rem] font-semibold transition-colors hover:border-accent hover:text-accent"
                    >
                      {disease.name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 pb-16 pt-4">
    <GuideSections lang={lang} sections={c.guide('diseases')} class="mt-14 first:mt-0" />

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="indice-alfabetico">
      <h2 id="indice-alfabetico" class="display text-[1.7rem]">
        {t.diseasesIndex.alphaHeading}
      </h2>
      <ul class="mt-6 grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          alphabetical.map((disease) => (
            <li class="text-[0.92rem]">
              <a href={c.urls.disease(disease.slug)} class="font-semibold transition-colors hover:text-accent">
                {disease.name}
              </a>
              <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-muted">{disease.summary}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
