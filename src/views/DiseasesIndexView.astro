---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import DiseaseCard from '../components/DiseaseCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { contentFor } from '../lib/content';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = contentFor(lang);

const categories = Array.from(
  new Map(c.diseases.map((d) => [d.categorySlug, d.category])).entries()
).map(([slug, label]) => ({ slug, label, count: c.diseases.filter((d) => d.categorySlug === slug).length }));

const breadcrumbs = [
  { name: t.common.home, href: c.urls.home() },
  { name: t.nav.diseases, href: c.urls.diseases() },
];
---

<BaseLayout lang={lang} title={`${t.diseasesIndex.title} | ${SITE.name}`} description={t.diseasesIndex.description} breadcrumbs={breadcrumbs}>
  <div class="mx-auto max-w-6xl px-5 pb-8 pt-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />

    <h1 class="display mt-6 text-[2.4rem] sm:text-[3.2rem]">{t.diseasesIndex.h1}</h1>
    <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-ink-muted">{t.diseasesIndex.lead}</p>

    <div class="mt-8 max-w-xl">
      <SearchBox lang={lang} variant="compact" />
    </div>

    <div class="mt-8 flex flex-wrap gap-2.5">
      {
        categories.map((category) => (
          <span class="rounded-full border border-line px-3.5 py-1.5 text-[0.82rem] text-ink-muted">
            {category.label} <span class="tabular-nums opacity-70">({category.count})</span>
          </span>
        ))
      }
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-5 pb-16" aria-label={t.diseasesIndex.listAria}>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {c.diseases.map((disease) => <DiseaseCard lang={lang} disease={disease} />)}
    </div>
  </section>
</BaseLayout>
