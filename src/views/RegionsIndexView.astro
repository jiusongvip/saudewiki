---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BodyMap from '../components/BodyMap.astro';
import GuideSections from '../components/GuideSections.astro';
import RegionGrid from '../components/RegionGrid.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { localeSpecs } from '../lib/i18n';
import { contentFor } from '../lib/content';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = contentFor(lang);

const breadcrumbs = [
  { name: t.common.home, href: c.urls.home() },
  { name: t.nav.regions, href: c.urls.regions() },
];

/**
 * Articles grouped by the place they talk about, derived from the diseases each
 * article names. The region owns no article list of its own — this is the same
 * derivation the region pages use, shown here as one index.
 */
const readings = c.regions
  .map((region) => ({ region, articles: c.regionArticles(region) }))
  .filter((entry) => entry.articles.length > 0);

const pageId = `${SITE.url}${c.urls.regions()}`;
const schemaNodes: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageId}#page`,
    name: t.regionsIndex.schemaName,
    description: t.regionsIndex.schemaDescription,
    inLanguage: localeSpecs[lang].hreflang,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    '@id': `${pageId}#lista`,
    name: t.regionsIndex.schemaName,
    numberOfItems: c.regions.length,
    itemListElement: c.regions.map((region, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: region.name,
      url: `${SITE.url}${c.urls.region(region.slug)}`,
    })),
  },
];
---

<BaseLayout lang={lang} title={`${t.regionsIndex.title} | ${SITE.name}`} description={t.regionsIndex.description} breadcrumbs={breadcrumbs} schemaNodes={schemaNodes}>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />

    <h1 class="display mt-6 text-[2.4rem] sm:text-[3.2rem]">{t.regionsIndex.h1}</h1>
    <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-ink-muted">{t.regionsIndex.lead}</p>
    <p class="mt-3 max-w-2xl text-[0.85rem] leading-relaxed text-ink-muted">
      {t.regionsIndex.constructionHint}
    </p>

    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="order-2 min-w-0 lg:order-1">
        <RegionGrid lang={lang} regions={c.regions} />
        <section class="mt-14 border-t border-line pt-10" aria-labelledby="como-o-corpo-se-divide">
          <h2 id="como-o-corpo-se-divide" class="display text-[1.8rem]">{t.regionsIndex.guideHeading}</h2>
          <div class="mt-5 max-w-2xl space-y-4 text-[0.98rem] leading-relaxed text-ink">
            {t.regionsIndex.guide.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <h3 class="mt-9 text-[1.08rem] font-extrabold tracking-tight">{t.regionsIndex.guideRegionsHeading}</h3>
          <dl class="mt-4 grid gap-x-10 gap-y-5 sm:grid-cols-2">
            {
              c.regions.map((region) => (
                <div>
                  <dt>
                    <a
                      href={c.urls.region(region.slug)}
                      class="text-[0.95rem] font-extrabold transition-colors hover:text-accent"
                    >
                      {region.name}
                    </a>
                  </dt>
                  <dd class="mt-1 text-[0.85rem] leading-relaxed text-ink-muted">{region.description}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        <GuideSections lang={lang} sections={c.guide('regions')} class="mt-14 first:mt-0" />
        {
          readings.length > 0 && (
            <section class="mt-14 border-t border-line pt-10" aria-labelledby="leituras-por-regiao">
              <h2 id="leituras-por-regiao" class="display text-[1.8rem]">
                {t.regionsIndex.regionArticlesHeading}
              </h2>
              <p class="mt-4 max-w-2xl text-[0.98rem] leading-relaxed text-ink">
                {t.regionsIndex.regionArticlesLead}
              </p>
              <dl class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                {
                  readings.map(({ region, articles }) => (
                    <div>
                      <dt>
                        <a
                          href={c.urls.region(region.slug)}
                          class="text-[0.95rem] font-extrabold transition-colors hover:text-accent"
                        >
                          {region.name}
                        </a>
                      </dt>
                      <dd class="mt-2 space-y-2">
                        {articles.map((article) => (
                          <a
                            href={c.urls.article(article.slug)}
                            class="block text-[0.88rem] leading-snug text-ink-muted transition-colors hover:text-accent"
                          >
                            {article.title}
                          </a>
                        ))}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </section>
          )
        }
        <section class="mt-14 border-t border-line pt-10" aria-labelledby="doencas-do-cotidiano">
          <h2 id="doencas-do-cotidiano" class="display text-[1.8rem]">{t.regionsIndex.allDiseasesHeading}</h2>
          <p class="mt-4 max-w-2xl text-[0.98rem] leading-relaxed text-ink">{t.regionsIndex.allDiseasesLead}</p>
          {
            c.diseases.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {c.diseases.map((disease) => (
                  <li>
                    <a
                      href={c.urls.disease(disease.slug)}
                      class="inline-flex rounded-full border border-control bg-canvas px-3.5 py-1.5 text-[0.82rem] font-semibold transition-colors hover:border-accent hover:text-accent"
                    >
                      {disease.name}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
      </div>
      <BodyMap lang={lang} regions={c.regions} class="order-1 lg:sticky lg:top-24 lg:order-2" />
    </div>
  </div>
</BaseLayout>
