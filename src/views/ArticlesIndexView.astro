---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicCard from '../components/TopicCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GuideSections from '../components/GuideSections.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { fill, localeSpecs } from '../lib/i18n';
import { contentFor, formatDateFor } from '../lib/content';
import { unitCount } from '../lib/counts';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const c = contentFor(lang);

const categories = Array.from(
  new Map(c.articles.map((a) => [a.categorySlug, a.category])).entries()
).map(([slug, label]) => ({ slug, label, count: c.articles.filter((a) => a.categorySlug === slug).length }));

/** Same rule as the disease index: Portuguese sorts, Chinese keeps editorial order. */
const alphabetical =
  lang === 'pt-BR'
    ? [...c.articles].sort((a, b) => a.title.localeCompare(b.title, 'pt', { sensitivity: 'base' }))
    : c.articles;

const latest = c.articles.reduce((acc, article) => (article.updatedAt > acc ? article.updatedAt : acc), '');

const breadcrumbs = [
  { name: t.common.home, href: c.urls.home() },
  { name: t.nav.articles, href: c.urls.articles() },
];

const topicsWithArticles = c.topics.filter((topic) => topic.articleSlugs.length > 0);

const pageId = `${SITE.url}${c.urls.articles()}`;
const schemaNodes: Record<string, unknown>[] = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageId}#page`,
    name: t.articlesIndex.h1,
    description: t.articlesIndex.description,
    inLanguage: localeSpecs[lang].hreflang,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    '@id': `${pageId}#lista`,
    name: t.articlesIndex.h1,
    numberOfItems: c.articles.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: alphabetical.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `${SITE.url}${c.urls.article(article.slug)}`,
    })),
  },
];
---

<BaseLayout lang={lang} title={`${t.articlesIndex.title} | ${SITE.name}`} description={t.articlesIndex.description} breadcrumbs={breadcrumbs} schemaNodes={schemaNodes}>
  <div class="mx-auto max-w-6xl px-5 pb-8 pt-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />

    <h1 class="display mt-6 text-[2.4rem] sm:text-[3.2rem]">{t.articlesIndex.h1}</h1>
    <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-ink-muted">{t.articlesIndex.lead}</p>
    {
      latest && (
        <p class="mt-3 text-[0.82rem] text-ink-muted">
          {fill(t.common.listUpdated, { date: formatDateFor(latest, lang) })}
        </p>
      )
    }

    <div class="mt-8 max-w-xl">
      <SearchBox lang={lang} variant="compact" />
    </div>

    <nav class="mt-8 flex flex-wrap gap-2.5" aria-label={t.articlesIndex.groupHeading}>
      {
        categories.map((category) => (
          <a
            href={`#grupo-${category.slug}`}
            class="rounded-full border border-line px-3.5 py-1.5 text-[0.82rem] text-ink-muted transition-colors hover:border-accent hover:text-accent"
          >
            {category.label} <span class="tabular-nums opacity-70">({category.count})</span>
          </a>
        ))
      }
    </nav>
  </div>

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-2" aria-labelledby="lista-de-artigos">
    <h2 id="lista-de-artigos" class="display text-[1.8rem]">
      {t.articlesIndex.listHeading}
    </h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {c.articles.map((article) => <ArticleCard lang={lang} article={article} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-4" aria-labelledby="por-grupo-artigos">
    <h2 id="por-grupo-artigos" class="display text-[1.8rem]">
      {t.articlesIndex.groupHeading}
    </h2>
    <p class="mt-4 max-w-2xl text-[0.98rem] leading-relaxed text-ink">{t.articlesIndex.groupLead}</p>

    <div class="mt-10 flex flex-col gap-14">
      {
        categories.map((category) => {
          const inGroup = alphabetical.filter((article) => article.categorySlug === category.slug);
          return (
            <section aria-labelledby={`grupo-${category.slug}`}>
              <h3
                id={`grupo-${category.slug}`}
                class="scroll-mt-24 text-[1.25rem] font-extrabold tracking-tight"
              >
                {category.label}
                <span class="ml-2 text-[0.9rem] font-semibold text-ink-muted">
                  {unitCount(lang, inGroup.length, 'article')}
                </span>
              </h3>
              <GuideSections lang={lang} sections={c.categoryGuide(category.slug)} class="mt-6" level={4} />
              <ul class="mt-6 space-y-2.5">
                {inGroup.map((article) => (
                  <li class="text-[0.92rem] leading-relaxed">
                    <a href={c.urls.article(article.slug)} class="font-semibold transition-colors hover:text-accent">
                      {article.title}
                    </a>
                    <span class="text-ink-muted"> — {article.excerpt}</span>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 pb-16 pt-4">
    <GuideSections lang={lang} sections={c.guide('articles')} class="mt-14 first:mt-0" />

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="indice-artigos">
      <h2 id="indice-artigos" class="display text-[1.7rem]">
        {t.articlesIndex.alphaHeading}
      </h2>
      <ul class="mt-6 grid gap-x-10 gap-y-3 sm:grid-cols-2">
        {
          alphabetical.map((article) => (
            <li class="text-[0.92rem]">
              <a href={c.urls.article(article.slug)} class="font-semibold transition-colors hover:text-accent">
                {article.title}
              </a>
              <span class="mt-0.5 block text-[0.78rem] text-ink-muted">
                {article.category} · {formatDateFor(article.updatedAt, lang)}
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  {
    topicsWithArticles.length > 0 && (
      <section class="border-t border-line bg-surface" aria-labelledby="navegar-por-tema">
        <div class="mx-auto max-w-6xl px-5 py-16">
          <h2 id="navegar-por-tema" class="display text-[1.8rem]">
            {t.articlesIndex.browseByTopic}
          </h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {topicsWithArticles.map((topic) => (
              <TopicCard lang={lang} topic={topic} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
