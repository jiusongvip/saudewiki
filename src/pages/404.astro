---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundView from '../views/NotFoundView.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';

/**
 * One document, both languages.
 *
 * A static host serves this single file for every address it cannot find, so
 * the build cannot know which language the reader was reaching for. Both bodies
 * ship in the markup and the script below keeps the one that matches the path
 * prefix. Nothing is fetched and nothing is rewritten: with scripting off the
 * Portuguese half is what remains, which is the site's default language.
 */
const pt = ui['pt-BR'];
const zh = ui['zh-Hant'];
---

<BaseLayout
  lang="pt-BR"
  title={`${pt.notFound.title} | ${SITE.name}`}
  description={pt.notFound.description}
  robots="noindex, follow"
>
  <div data-lang="pt-BR">
    <NotFoundView lang="pt-BR" />
  </div>

  <div data-lang="zh-Hant" hidden data-title={`${zh.notFound.title} | ${SITE.name}`}>
    <NotFoundView lang="zh-Hant" />
  </div>

  <script>
    const zhPanel = document.querySelector<HTMLElement>('[data-lang="zh-Hant"]');
    const ptPanel = document.querySelector<HTMLElement>('[data-lang="pt-BR"]');

    if (zhPanel && ptPanel && window.location.pathname.startsWith('/zh-Hant')) {
      ptPanel.hidden = true;
      zhPanel.hidden = false;
      document.documentElement.lang = 'zh-Hant';
      document.title = zhPanel.dataset.title ?? document.title;
    }
  </script>
</BaseLayout>
