---
import TopicDetailView from '../../views/TopicDetailView.astro';
import { contentFor } from '../../lib/content';
import type { Topic } from '../../types';

export function getStaticPaths() {
  return contentFor('pt-BR').topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
---

<TopicDetailView lang="pt-BR" topic={topic} />
