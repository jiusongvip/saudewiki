---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import WindowGrid from '../components/WindowGrid.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../data/site';
import {
  formatDatePtBr,
  publishedArticles,
  publishedDiseases,
  publishedTopics,
  url,
} from '../lib/content';
import { imageForDisease, imageForTopic } from '../lib/images';

/*
 * The photographs the layout itself is built from. They are the set the
 * reference uses, downloaded and self-hosted rather than linked, so the page
 * has no third-party dependency and the files can be sized and compressed here.
 *
 * Disease and topic pictures are NOT here: those belong to a slug, so they come
 * from `lib/images.ts`. Mixing the two would mean a picture that silently stops
 * following its content.
 */
const PHOTO = {
  hero: '/img/foco-hero.jpg',
  collage: '/img/foco-cuidados.jpg',
  curadoria: '/img/foco-curadoria.jpg',
};

const ALT = {
  hero: 'Mãos digitando em um notebook com um estetoscópio sobre a mesa',
  curadoria: 'Médico de jaleco branco usando um celular',
};

/*
 * The shortcuts under the search box. These are searches, not sections: they
 * hand the query straight to /busca/ and are the fastest route from "I have a
 * symptom" to something readable. Four of them, so the row stays one line on a
 * laptop and two on a phone.
 */
const quickSearches = ['Dengue', 'Diabetes', 'Hipertensão', 'Vacinação'];

/*
 * What the site can honestly say about its own verification, taken from the
 * editorial policy rather than written fresh for the home page.
 *
 * The third item is the point of the block. The project has no medical review
 * board yet, and for medical content the only defensible option is to say so —
 * a home page that implies a sign-off nobody performed is worse than one that
 * admits the gap.
 */
const verification = [
  {
    title: 'Fontes públicas',
    body: 'Ministério da Saúde, Fiocruz e OMS. Cada afirmação aponta para o documento que a sustenta.',
  },
  {
    title: 'Autoria e data',
    body: 'Toda página informa quem escreveu, o estado editorial do texto e quando foi atualizada.',
  },
  {
    title: 'Revisão declarada',
    body: 'Ainda não há corpo de revisores médicos formalizado, e a página diz isso, em vez de sugerir uma revisão que não houve.',
  },
  {
    title: 'Correção aberta',
    body: 'Qualquer pessoa pode reportar um erro; a correção é avaliada antes de o texto mudar.',
  },
];

const diseases = publishedDiseases.slice(0, 3);
const articles = publishedArticles.slice(0, 6);

/*
 * Topics are listed only when they have something in them. `saude-da-mulher` is
 * published but still empty, and advertising an empty section on the front page
 * would be the same kind of lie as inventing a reviewer. The filter is on the
 * content, not on a slug, so the topic appears by itself once it is written.
 */
const topics = publishedTopics
  .filter((topic) => topic.diseaseSlugs.length + topic.articleSlugs.length > 0)
  .slice(0, 4);
---

<BaseLayout
  title={`${SITE.name} | Informação de saúde para todos`}
  description={SITE.description}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={PHOTO.hero} fetchpriority="high" />
  </Fragment>

  <!-- A. Hero. Brand, promise, search — and nothing else. The three pillar bars
       that used to sit above this were cut: they repeated the header nav, and
       without them the photograph gets the whole screen and the search box can
       be the size it needs to be.

       Nothing here carries `.reveal`. A control that fades in can be clicked
       before it exists. -->
  <section
    class="flex h-[calc(100svh-4rem)] min-h-[600px] w-full flex-col gap-2 overflow-hidden px-5 pb-2 pt-2 md:px-5 md:pt-3"
  >
    <div class="relative min-h-0 flex-1 overflow-hidden rounded-xl md:rounded-2xl">
      <img
        src={PHOTO.hero}
        alt={ALT.hero}
        class="h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />

      <!--
        One flex column instead of two absolutely positioned corners. With both
        corners pinned independently, a short viewport lets the description run
        straight through the headline; as rows in a column the two simply cannot
        occupy the same space.
      -->
      <div class="absolute inset-0 flex flex-col justify-between p-5 md:p-8">
        <div class="flex items-start justify-between gap-4">
          <p
            class="hero-note max-w-[190px] text-xs font-bold leading-tight text-white md:max-w-[320px] md:text-lg"
          >
            Informação de saúde clara, gratuita e baseada em fontes confiáveis.
          </p>
          <p class="hidden shrink-0 text-xs font-bold text-white/80 md:block md:text-sm">
            Conteúdo gratuito
          </p>
        </div>

        <div>
          <p class="mb-1 text-[0.68rem] font-bold text-white/80 md:mb-2 md:text-sm">
            Saudewiki · pt-BR
          </p>
          <h1 class="t-mega text-white">Entenda<br />sua saúde.</h1>

          <div class="mt-5 max-w-xl md:mt-7 md:max-w-2xl">
            <SearchBox variant="hero" />
          </div>

          <ul class="mt-3 flex flex-wrap gap-2 md:mt-4">
            {
              quickSearches.map((term) => (
                <li>
                  <a
                    href={url.search(term)}
                    class="inline-flex rounded-full bg-white px-5 py-1.5 text-[0.72rem] font-bold text-black transition-transform duration-200 hover:scale-105 md:px-4 md:py-2 md:text-sm"
                  >
                    {term}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- B. The encyclopedia. An asymmetric grid whose anchor is a single
       photograph shown through two windows: the picture runs through the gutter,
       so the two panels read as one image with a cut in it. The disease entries
       beside it are separate cards with their own pictures — a window is a
       crop, and a crop cannot be trusted to show the right disease. -->
  <section class="w-full px-5 py-2 md:min-h-[100svh] md:px-5 md:py-3">
    <div class="flex flex-col gap-2 md:h-[calc(100svh-5.5rem)]">
      <div class="flex flex-wrap items-end justify-between gap-3 px-1 pb-1">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-accent-strong">Enciclopédia</p>
          <h2 class="t-big mt-1 text-ink">Explore doenças</h2>
        </div>
        <a
          href={url.diseases()}
          class="shrink-0 text-sm font-bold text-accent-strong underline-offset-4 hover:underline"
        >
          Ver todas as doenças
        </a>
      </div>

      <div class="grid min-h-0 flex-1 grid-cols-2 gap-2 md:grid-cols-3 md:grid-rows-2">
        <WindowGrid
          src={PHOTO.collage}
          class="col-span-2 flex min-h-[320px] flex-col gap-2 md:col-span-1 md:row-span-2"
        >
          <div data-window class="min-h-0 flex-1 rounded-2xl" aria-hidden="true"></div>
          <div data-window class="min-h-0 flex-1 rounded-2xl" aria-hidden="true"></div>
        </WindowGrid>

        {
          diseases.map((disease) => {
            const image = imageForDisease(disease.slug);
            return (
              <a
                href={url.disease(disease.slug)}
                class="relative min-h-[200px] overflow-hidden rounded-2xl md:min-h-[220px]"
              >
                <img
                  src={image?.src}
                  alt={image?.alt ?? ''}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <span
                  class="scrim-top pointer-events-none absolute inset-x-0 top-0 h-[72%]"
                  aria-hidden="true"
                />
                <div class="absolute inset-x-4 top-4 md:inset-x-5 md:top-5">
                  <p class="text-[0.66rem] font-bold uppercase tracking-wider text-white/80">
                    {disease.category}
                  </p>
                  <h3 class="mt-1 text-xl font-extrabold leading-tight tracking-tight text-white md:text-2xl">
                    {disease.name}
                  </h3>
                </div>
              </a>
            );
          })
        }

        <a
          href={url.diseases()}
          class="flex min-h-[200px] flex-col justify-between rounded-2xl bg-sand p-5 md:min-h-[220px]"
        >
          <span class="num text-ink">
            <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </span>
          <span class="text-xl font-extrabold leading-tight tracking-tight text-ink md:text-2xl">
            Todas as doenças
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- C. Recent articles. The module that carries search traffic, so every entry
       states its category, its date and what it actually says. Six text cards,
       deliberately with no thumbnails: a grid of pictures with no information
       underneath is not an article list. -->
  <section class="w-full px-5 py-6 md:px-5 md:py-10">
    <div class="flex flex-wrap items-end justify-between gap-3 px-1 pb-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-accent-strong">Artigos</p>
        <h2 class="t-big mt-1 text-ink">Leituras recentes</h2>
      </div>
      <a
        href={url.articles()}
        class="shrink-0 text-sm font-bold text-accent-strong underline-offset-4 hover:underline"
      >
        Ver todos os artigos
      </a>
    </div>

    <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <a
            href={url.article(article.slug)}
            class="group flex flex-col rounded-2xl bg-sand p-5 transition-colors duration-200 hover:bg-mist md:p-6"
          >
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="text-[0.66rem] font-bold uppercase tracking-wider text-accent-strong">
                {article.category}
              </span>
              <span class="text-[0.7rem] text-ink-muted">
                {formatDatePtBr(article.updatedAt)}
              </span>
            </div>

            <h3 class="mt-3 text-lg font-extrabold leading-snug tracking-tight text-ink md:text-xl">
              {article.title}
            </h3>

            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{article.excerpt}</p>

            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-accent-strong">
              Ler artigo
              <Icon
                name="tabler:arrow-right"
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
              />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- D. Topics. Organised by what a reader is worried about rather than by
       diagnosis, which is how people actually arrive. -->
  <section class="w-full px-5 py-6 md:px-5 md:py-10">
    <div class="flex flex-wrap items-end justify-between gap-3 px-1 pb-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-accent-strong">Temas</p>
        <h2 class="t-big mt-1 text-ink">Por assunto</h2>
      </div>
      <a
        href={url.topics()}
        class="shrink-0 text-sm font-bold text-accent-strong underline-offset-4 hover:underline"
      >
        Ver todos os temas
      </a>
    </div>

    <div class="grid gap-2 sm:grid-cols-2">
      {
        topics.map((topic) => {
          const image = imageForTopic(topic.slug);
          const total = topic.diseaseSlugs.length + topic.articleSlugs.length;
          return (
            <a
              href={url.topic(topic.slug)}
              class="relative min-h-[240px] overflow-hidden rounded-2xl md:min-h-[300px]"
            >
              <img
                src={image?.src}
                alt={image?.alt ?? ''}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <span
                class="scrim-top pointer-events-none absolute inset-x-0 top-0 h-[78%]"
                aria-hidden="true"
              />
              <div class="absolute inset-x-5 top-5 md:inset-x-7 md:top-7">
                <h3 class="text-2xl font-extrabold leading-tight tracking-tight text-white md:text-3xl">
                  {topic.title}
                </h3>
                <p class="mt-2 max-w-[34ch] text-xs font-semibold leading-snug text-white/85 md:text-sm">
                  {topic.description}
                </p>
                <p class="mt-3 text-[0.7rem] font-bold uppercase tracking-wider text-white/70">
                  {total} conteúdo{total > 1 ? 's' : ''} neste tema
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- E. Verification. The reference ends on a photograph; this page ends on the
       site's own provenance, because the last thing a medical site should say
       about itself is where its information comes from — and what it does not
       yet have. -->
  <section class="w-full px-5 py-6 md:px-5 md:py-10">
    <div class="rounded-2xl bg-deep p-6 md:p-10">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
        <div class="md:max-w-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-white/60">Verificação editorial</p>
          <h2 class="t-big mt-2 text-white">Como<br />verificamos</h2>
          <p class="mt-4 text-sm leading-relaxed text-white/70 md:text-base">
            Informação de saúde só serve se der para conferir. Estas são as regras que o projeto
            segue, e o que ele ainda não tem.
          </p>
          <a href={url.editorial()} class="pill mt-6">Ler a política editorial</a>
        </div>

        <ul class="grid gap-2 sm:grid-cols-2 md:w-[52%]">
          {
            verification.map((item, index) => (
              <li class="glass flex flex-col rounded-xl p-4 md:rounded-2xl md:p-5">
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <span class="mt-5 block text-base font-extrabold leading-tight tracking-tight md:text-xl">
                  {item.title}
                </span>
                <span class="mt-2 block text-xs leading-snug text-white/75 md:text-sm">
                  {item.body}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- F. The project, and the way out. -->
  <section class="w-full px-5 pb-3 pt-2 md:px-5 md:pb-5">
    <div class="grid gap-2 md:grid-cols-2">
      <div class="flex flex-col justify-between rounded-2xl bg-mist p-6 md:p-10">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Sobre o projeto</p>
          <h2 class="t-big mt-2 text-ink">Saúde acessível,<br />em português</h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-muted md:text-base">
            {SITE.description}
          </p>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          <li><a href={url.about()} class="pill">Sobre o Saudewiki</a></li>
          <li><a href={url.editorial()} class="pill">Política editorial</a></li>
          <li><a href={url.contact()} class="pill">Contato</a></li>
          <li><a href={url.privacy()} class="pill">Privacidade</a></li>
        </ul>
      </div>

      <div class="relative min-h-[280px] overflow-hidden rounded-2xl md:min-h-[380px]">
        <img
          src={PHOTO.curadoria}
          alt={ALT.curadoria}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
</BaseLayout>
