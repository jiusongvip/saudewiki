---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicCard from '../../components/TopicCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedArticles, publishedTopics, url } from '../../lib/content';
import { SITE } from '../../data/site';

const categories = Array.from(
  new Map(publishedArticles.map((a) => [a.categorySlug, a.category])).entries()
).map(([slug, label]) => ({ slug, label, count: publishedArticles.filter((a) => a.categorySlug === slug).length }));

const breadcrumbs = [
  { name: 'Início', href: '/' },
  { name: 'Artigos', href: url.articles() },
];

const topicsWithArticles = publishedTopics.filter((topic) => topic.articleSlugs.length > 0);
---

<BaseLayout
  title={`Artigos de saúde | ${SITE.name}`}
  description="Artigos em português sobre sintomas, prevenção e cuidados com a saúde, ligados às páginas de doenças correspondentes."
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-6xl px-5 pb-8 pt-10">
    <Breadcrumbs items={breadcrumbs} />

    <h1 class="display mt-6 text-[2.4rem] sm:text-[3.2rem]">Artigos de saúde</h1>
    <p class="mt-4 max-w-2xl text-[1rem] leading-relaxed text-ink-muted">
      Textos curtos que respondem a dúvidas específicas e levam para a página da doença correspondente, onde o
      assunto é tratado por completo.
    </p>

    <div class="mt-8 max-w-xl">
      <SearchBox variant="compact" />
    </div>

    <div class="mt-8 flex flex-wrap gap-2.5">
      {
        categories.map((category) => (
          <span class="rounded-full border border-line px-3.5 py-1.5 text-[0.82rem] text-ink-muted">
            {category.label} <span class="tabular-nums opacity-70">({category.count})</span>
          </span>
        ))
      }
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-5 pb-16" aria-label="Lista de artigos">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {publishedArticles.map((article) => <ArticleCard article={article} />)}
    </div>

    <p class="mt-10 text-[0.82rem] leading-relaxed text-ink-muted">
      Todos os artigos acima estão marcados como material de demonstração e aguardam revisão médica. Textos em
      rascunho não aparecem nesta lista.
    </p>
  </section>

  {
    topicsWithArticles.length > 0 && (
      <section class="border-t border-line bg-surface" aria-labelledby="navegar-por-tema">
        <div class="mx-auto max-w-6xl px-5 py-16">
          <h2 id="navegar-por-tema" class="display text-[1.8rem]">
            Navegar por tema
          </h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {topicsWithArticles.map((topic) => (
              <TopicCard topic={topic} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
