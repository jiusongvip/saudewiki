---
import ArticleDetailView from '../../views/ArticleDetailView.astro';
import { contentFor } from '../../lib/content';
import type { Article } from '../../types';

export function getStaticPaths() {
  return contentFor('pt-BR').articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<ArticleDetailView lang="pt-BR" article={article} />
