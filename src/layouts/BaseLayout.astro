---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE } from '../data/site';
// The two weights that paint above the fold: 400 for body text, 600 for every
// `.display` heading. Imported as URLs so Vite resolves the same hashed asset
// the stylesheet references, which lets the preload actually be reused.
import fontBody from '@fontsource/open-sauce-one/files/open-sauce-one-latin-400-normal.woff2?url';
import fontHeading from '@fontsource/open-sauce-one/files/open-sauce-one-latin-600-normal.woff2?url';
import { ui } from '../i18n/ui';
import { localeSpecs, locales, localizePath, rootPath, defaultLocale } from '../lib/i18n';
import type { Locale } from '../types';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  lang: Locale;
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
  /**
   * Let the page run to the edge of the window. The home page needs this: its
   * composition is full-bleed tiles separated by a 6px grout, and a centred
   * `max-width` container would turn that into a framed poster. Every other page
   * keeps the shell, because running body text edge to edge is unreadable.
   */
  bleed?: boolean;
  /** Extra Schema.org nodes merged into the page @graph. */
  schemaNodes?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  canonical,
  robots,
  ogType = 'website',
  ogImage = '/og-1200x630.png',
  breadcrumbs = [],
  bleed = false,
  schemaNodes = [],
} = Astro.props;

const spec = localeSpecs[lang];
const t = ui[lang];

const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(pathname, Astro.site).href;
const absoluteOgImage = new URL(ogImage, Astro.site).href;
/**
 * A page kept out of the index should not spend the head on pointing at itself:
 * a canonical and an hreflang set on a `noindex` document is noise Google has to
 * reconcile. Derived from `robots` so the two can never disagree.
 */
const indexed = !robots?.includes('noindex');

/**
 * hreflang alternates.
 *
 * Both languages share their slugs, so an alternate is the same path with the
 * locale prefix swapped: no per-page table of twins to maintain, and a new page
 * is automatically correctly paired the moment it exists in both languages.
 * `x-default` points at the root locale, which is the version for a reader whose
 * language the site cannot tell.
 */
const neutralPath = rootPath(pathname);
const alternates = locales.map((code) => ({
  hreflang: localeSpecs[code].hreflang,
  href: new URL(localizePath(neutralPath, code), Astro.site).href,
}));

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: t.site.description,
    inLanguage: locales.map((code) => localeSpecs[code].hreflang),
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
    logo: `${SITE.url}/logo-512.png`,
    sameAs: [SITE.github],
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, SITE.url).href,
    })),
  });
}

graph.push(...schemaNodes);

const schemaJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang={spec.htmlLang} dir={spec.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontBody}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontHeading}
      crossorigin="anonymous"
    />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      indexed && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localizePath(neutralPath, defaultLocale), Astro.site).href}
          />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={spec.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <script type="application/ld+json" set:html={schemaJson} />

    <!-- Page-specific head extras, e.g. preloading the LCP image. -->
    <slot name="head" />

    <!--
      Reveal is opt-in, not opt-out. The class is added here, before paint, and
      the CSS only hides `.reveal` while it is present. With scripting off the
      class never lands and every section is simply visible. The timer is the
      second half of the same idea: if the bundle that drives the observer
      never signals, the class comes off again rather than leaving the page
      blank below the fold.

      The handshake uses a class rather than a `data-*` attribute on purpose.
      The dist gate cross-references every `data-*` token a script touches
      against the built markup, and a runtime-only marker reads there as a
      dangling hook. A class is not scanned, so the gate stays a clean signal.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('reveal-on');
        setTimeout(function () {
          if (!root.classList.contains('reveal-live')) root.classList.remove('reveal-on');
        }, 2500);
      })();
    </script>
  </head>
  <body class="flex min-h-[100dvh] flex-col bg-canvas text-ink antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-canvas"
    >
      {t.nav.skip}
    </a>

    <Nav lang={lang} />

    <main id="conteudo" class:list={['flex-1', !bleed && 'shell']}>
      <slot />
    </main>

    <Footer lang={lang} />

    <BackToTop lang={lang} />

    <script>
      // Bundled (not is:inline) so the observer is defined once per page rather
      // than duplicated for every component instance.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      // Tells the inline head script this bundle arrived, so its fallback timer
      // does not undo the hiding. See the comment in <head>.
      document.documentElement.classList.add('reveal-live');

      const show = (el: HTMLElement) => el.classList.add('reveal-in');

      if (prefersReduced || targets.length === 0) {
        targets.forEach(show);
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                show(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );
        targets.forEach((el) => observer.observe(el));

        /*
         * Safety net. The observer alone left elements at opacity 0 forever:
         * the negative rootMargin insets the bottom of the viewport, and a
         * section parked in that last sliver never counts as intersecting.
         * This sweep reveals anything already at least partly on screen,
         * independent of the observer's geometry.
         */
        let queued = false;
        const sweep = () => {
          queued = false;
          const limit = window.innerHeight;
          for (const el of targets) {
            if (!el.classList.contains('reveal-in') && el.getBoundingClientRect().top < limit) {
              show(el);
              observer.unobserve(el);
            }
          }
        };
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };

        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        window.addEventListener('load', queue);
        queue();
      }
    </script>
  </body>
</html>
