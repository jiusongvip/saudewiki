---
import { Icon } from 'astro-icon/components';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Trilha de navegação" class="text-[0.82rem]">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-muted">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <Icon name="tabler:chevron-right" class="h-3.5 w-3.5 opacity-60" />}
          {index === items.length - 1 ? (
            <span aria-current="page" class="font-medium text-ink">{item.name}</span>
          ) : (
            <a href={item.href} class="transition-colors hover:text-accent">{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
