---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../types';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  lang: Locale;
  items: Crumb[];
}

const { lang, items } = Astro.props;
const t = ui[lang];
---

<nav aria-label={t.nav.breadcrumb} class="text-[0.82rem]">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-muted">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <Icon name="tabler:chevron-right" class="h-3.5 w-3.5 opacity-60" />}
          {index === items.length - 1 ? (
            <span aria-current="page" class="font-medium text-ink">{item.name}</span>
          ) : (
            <a href={item.href} class="transition-colors hover:text-accent">{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
