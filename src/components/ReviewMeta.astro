---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { fill } from '../lib/i18n';
import { formatDateFor } from '../lib/content';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
  author: string;
  reviewer: string | null;
  reviewStatus: 'draft' | 'needs_review' | 'reviewed' | 'published';
  publishedAt: string;
  updatedAt: string;
}

const { lang, author, reviewer, reviewStatus, publishedAt, updatedAt } = Astro.props;
const t = ui[lang];

/**
 * Editorial provenance block. The badge carries the review stage; a reviewer
 * row is added only when a real name signed the page off.
 */
---

<div class="rounded-xl border border-line bg-surface p-5">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-200 bg-accent-soft px-3 py-1 text-[0.72rem] font-semibold text-accent-strong">
      <Icon name="tabler:clipboard-check" class="h-3.5 w-3.5" />
      {t.review[reviewStatus]}
    </span>
    <span class="text-[0.8rem] text-ink-muted">{fill(t.common.byAuthor, { author })}</span>
  </div>

  <dl class="mt-4 grid gap-x-8 gap-y-2 text-[0.8rem] sm:grid-cols-2">
    {
      reviewer && (
        <div class="flex gap-1.5">
          <dt class="text-ink-muted">{t.common.medicalReview}</dt>
          <dd class="font-medium text-ink">{reviewer}</dd>
        </div>
      )
    }
    <div class="flex gap-1.5">
      <dt class="text-ink-muted">{t.common.publishedOn}</dt>
      <dd class="font-medium text-ink">{formatDateFor(publishedAt, lang)}</dd>
    </div>
    <div class="flex gap-1.5">
      <dt class="text-ink-muted">{t.common.lastUpdate}</dt>
      <dd class="font-medium text-ink">{formatDateFor(updatedAt, lang)}</dd>
    </div>
  </dl>
</div>
