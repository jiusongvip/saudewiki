---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { contentFor } from '../lib/content';
import InlineText from './InlineText.astro';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
  /** Short label describing what kind of placeholder this is. */
  label?: string;
}

const { lang, label = ui[lang].common.placeholderLabel } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;
---

<aside class="rounded-xl border border-warn/30 bg-warn-soft p-4" role="note">
  <div class="flex gap-3">
    <Icon name="tabler:alert-triangle" class="mt-0.5 h-4 w-4 shrink-0 text-warn" />
    <div class="text-[0.82rem] leading-relaxed text-ink">
      <p class="font-semibold">{label}</p>
      <p class="mt-1 text-ink-muted">
        <InlineText text={t.common.placeholderBody} lang={lang} />
      </p>
      <p class="mt-2">
        <a href={urls.contact()} class="font-medium text-accent underline underline-offset-2">
          {t.common.placeholderLink}
        </a>
      </p>
    </div>
  </div>
</aside>
