---
import { Icon } from 'astro-icon/components';
import { url } from '../lib/content';

interface Props {
  /** Short label describing what kind of placeholder this is. */
  label?: string;
}

const { label = 'Conteúdo de demonstração' } = Astro.props;
---

<aside class="rounded-xl border border-warn/30 bg-warn-soft p-4" role="note">
  <div class="flex gap-3">
    <Icon name="tabler:alert-triangle" class="mt-0.5 h-4 w-4 shrink-0 text-warn" />
    <div class="text-[0.82rem] leading-relaxed text-ink">
      <p class="font-semibold">{label}</p>
      <p class="mt-1 text-ink-muted">
        Este texto foi escrito para validar a estrutura da página e <strong class="font-semibold">ainda não passou por
        revisão médica</strong>. Ele não deve ser usado para tomar decisões sobre saúde.
      </p>
      <p class="mt-2">
        <a href={url.contact()} class="font-medium text-accent underline underline-offset-2">
          Encontrou um erro? Envie uma correção
        </a>
      </p>
    </div>
  </div>
</aside>
