---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { fill } from '../lib/i18n';
import { navItems, contentFor } from '../lib/content';
import BrandLockup from './BrandLockup.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === urls.home() ? pathname === href : pathname.startsWith(href);
---

<header
  id="main-nav"
  class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-md"
>
  <div class="shell flex h-16 items-center gap-3 px-5">
    <a href={urls.home()} class="shrink-0" aria-label={fill(t.nav.brandAria, { site: SITE.name })}>
      <BrandLockup />
    </a>

    <nav class="ml-auto hidden items-center gap-5 lg:gap-7 md:flex" aria-label={t.nav.ariaMain}>
      {
        navItems(lang).map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-[0.9rem] transition-colors hover:text-accent',
              isActive(item.href) ? 'font-semibold text-accent' : 'text-ink-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <LanguageSwitcher lang={lang} class="ml-auto md:ml-4" />

    <!-- `border-control`, not `border-line`: this is the edge of a control, and
         WCAG 1.4.11 asks 3:1 for it. Decorative rules use `border-line`. -->
    <a
      href={urls.search()}
      class="mt-4 hidden items-center gap-2 rounded-full border border-control px-4 py-2 text-[0.85rem] font-semibold transition-colors hover:border-accent hover:text-accent md:mt-0 md:inline-flex md:ml-6"
    >
      <Icon name="tabler:search" class="h-4 w-4" />
      {t.nav.search}
    </a>

    <button
      id="mobile-menu-btn"
      type="button"
      aria-label={t.nav.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open-label={t.nav.openMenu}
      data-close-label={t.nav.closeMenu}
      class="ml-2 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-control md:hidden"
    >
      <Icon name="tabler:menu-2" class="h-5 w-5" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas px-5 pb-5 pt-3 md:hidden">
    <nav class="flex flex-col" aria-label={t.nav.ariaMobile}>
      {
        navItems(lang).map((item) => (
          <a
            href={item.href}
            class="border-b border-line py-3 text-[0.95rem] last:border-0"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={urls.search()}
        class="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-accent px-4 py-3 text-[0.9rem] font-semibold text-canvas"
      >
        <Icon name="tabler:search" class="h-4 w-4" />
        {t.nav.search}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const labels = button.dataset;
    button.addEventListener('click', () => {
      const nowHidden = menu.classList.toggle('hidden');
      button.setAttribute('aria-expanded', String(!nowHidden));
      button.setAttribute(
        'aria-label',
        nowHidden ? labels.openLabel ?? '' : labels.closeLabel ?? ''
      );
    });
  }
</script>
