---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { fill } from '../lib/i18n';
import { contentFor } from '../lib/content';
import { imageForTopic } from '../lib/images';
import ImageSlot from './ImageSlot.astro';
import type { Locale, Topic } from '../types';

interface Props {
  lang: Locale;
  topic: Topic;
  ratio?: string;
}

const { lang, topic, ratio = '3 / 2' } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;
const image = imageForTopic(topic.slug, lang);
const total = topic.diseaseSlugs.length + topic.articleSlugs.length;
const meta =
  total > 0
    ? fill(t.common.contentInTopic, {
        n: total,
        unit: total > 1 ? t.common.units.contentMany : t.common.units.contentOne,
      })
    : t.common.topicInPreparation;
---

<a href={urls.topic(topic.slug)} class="card card-link group flex flex-col overflow-hidden">
  <ImageSlot src={image?.src} alt={image?.alt ?? ''} ratio={ratio} />

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{topic.title}</h3>
      <Icon
        name="tabler:arrow-up-right"
        class="mt-0.5 h-4 w-4 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </div>
    <p class="mt-2 flex-1 text-[0.9rem] leading-relaxed text-ink-muted">{topic.description}</p>
    <p class="mt-5 text-[0.78rem] text-ink-muted">{meta}</p>
  </div>
</a>
