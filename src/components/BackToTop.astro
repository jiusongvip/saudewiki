---
import { ui } from '../i18n/ui';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<button
  id="back-to-top"
  type="button"
  aria-label={t.nav.backToTop}
  class="fixed bottom-6 right-6 z-[60] invisible flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-line bg-canvas/90 text-ink-muted opacity-0 shadow-lg backdrop-blur-sm transition-all duration-300 pointer-events-none hover:-translate-y-0.5 hover:text-accent hover:shadow-xl"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-5 w-5"
    viewBox="0 0 20 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z"
      clip-rule="evenodd"
    />
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');

  if (btn) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const toggle = () => {
      const up = window.scrollY > 400;
      btn.classList.toggle('invisible', !up);
      btn.classList.toggle('opacity-0', !up);
      btn.classList.toggle('pointer-events-none', !up);
      btn.classList.toggle('pointer-events-auto', up);
      btn.classList.toggle('opacity-100', up);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        toggle();
        ticking = false;
      });
    };

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
    });
    window.addEventListener('scroll', onScroll, { passive: true });
    toggle();
  }
</script>
