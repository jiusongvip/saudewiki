---
/**
 * The brand mark: a ring crossed by a single arterial pulse.
 *
 * Both strokes ride theme tokens rather than hard-coded fills, so the same file
 * serves the light header and the dark one — `--color-accent` is deep teal by
 * day and mint by night, which is the inversion the mark wants anyway.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true" focusable="false">
  <circle
    class="text-accent"
    cx="24"
    cy="24"
    r="17.5"
    stroke="currentColor"
    stroke-width="4.6"
  />
  <path
    class="text-ink"
    d="M3 24h10l3.4-9.6 6.2 19.2 3.4-9.6H45"
    stroke="currentColor"
    stroke-width="4.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
