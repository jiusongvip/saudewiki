---
/**
 * The brand mark: a filled disc with a single arterial pulse knocked out.
 *
 * The disc rides `--color-accent` (deep teal by day, mint by night) while the
 * knocked-out pulse rides `--color-canvas`, so the pulse always reads as a
 * window through the disc to whatever surface the mark sits on. Nav and
 * footer both sit on a canvas-tinted background, which is the inversion the
 * mark wants anyway.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true" focusable="false">
  <circle
    class="text-accent"
    cx="24"
    cy="24"
    r="21"
    fill="currentColor"
  />
  <path
    class="text-canvas"
    d="M3 24h13l4.5-12 4.5 23 3.5-16 2.5 5h7"
    stroke="currentColor"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
