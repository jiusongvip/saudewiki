---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { contentFor } from '../lib/content';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
  value?: string;
  variant?: 'hero' | 'compact';
}

const { lang, value = '', variant = 'compact' } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;
const inputId = `busca-${lang}-${variant}`;
const isHero = variant === 'hero';

/**
 * A real GET form, not a JS-only widget: submitting works with JavaScript
 * disabled, and the resulting URL carries the query so it can be shared and
 * reloaded. The form posts to *this language's* /busca/, so a Chinese query
 * never lands on the Portuguese index.
 *
 * The two variants are styled quite differently on purpose. The compact one
 * sits on the page, so it can use the theme's tokens and its edge is the visual
 * information WCAG 1.4.11 asks 3:1 for. The hero one sits on a photograph as a
 * white pill, so its colours are pinned in CSS instead: the theme's ink colour
 * would otherwise be near-white in dark mode and vanish against the pill.
 */
---

<form
  action={urls.search()}
  method="get"
  role="search"
  class:list={[
    'flex w-full items-center gap-2',
    isHero
      ? 'search-hero rounded-full p-2 shadow-lg'
      : 'rounded-full border border-control bg-surface p-1.5',
  ]}
>
  <label class="sr-only" for={inputId}>{t.search.label}</label>
  <Icon
    name="tabler:search"
    class:list={[
      'shrink-0',
      isHero ? 'ml-4 h-6 w-6 text-black/45' : 'ml-2.5 h-4 w-4 text-ink-muted',
    ]}
  />
  <input
    id={inputId}
    type="search"
    name="q"
    value={value}
    autocomplete="off"
    placeholder={t.search.placeholder}
    class:list={[
      'min-w-0 flex-1 bg-transparent outline-none',
      isHero
        ? 'px-2 py-4 text-base md:text-lg'
        : 'px-1 py-2 text-sm text-ink placeholder:text-ink-muted/70',
    ]}
  />
  <button
    type="submit"
    class:list={[
      'shrink-0 rounded-full bg-accent font-semibold text-canvas transition-colors hover:bg-accent-strong',
      isHero ? 'px-8 py-4 text-base' : 'px-4 py-2 text-[0.8rem]',
    ]}
  >
    {t.search.button}
  </button>
</form>
