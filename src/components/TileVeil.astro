---
/**
 * The warning over a disease tile on the home page.
 *
 * It is the same cover `SensitiveImage` draws, in the same words: a badge, the
 * notice, the range of what the plate can show, and one control that opens it.
 * A reader who has met the cover on a plate meets it here unchanged, which is
 * the point — the cover is one idea and it should not have two shapes.
 *
 * What the tile adds is a second way through. The entry's category, name and
 * summary sit on the picture, outside the cover and above it, and they are the
 * link: a press on the words opens the entry, a press anywhere else lifts the
 * veil. That is why the tile is a `div` rather than an anchor — the cover is a
 * button and may not be nested inside a link — and why the words carry their own
 * anchor instead of a stretched link over the whole tile, which the cover would
 * sit on top of.
 *
 * Once the cover is open the words' anchor stretches back over the whole tile
 * (`::after`, drawn from the one link), so the picture becomes the way into the
 * entry the way it is on every other card, and the pill in the corner is the way
 * back to a blurred picture. The state lives on the tile (`data-gate-state`), so
 * the same delegated listener in `BaseLayout` opens this and a full cover
 * without knowing which is which, and the `<noscript>` block clears it when
 * scripting is off.
 */
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = ui[lang].imageGate;
---

<button type="button" class="tile-veil-toggle" data-gate-toggle aria-expanded="false">
  <span class="gate-shut">
    <span class="gate-badge">
      <Icon name="tabler:alert-triangle" class="h-4 w-4" />
    </span>
    <span class="gate-title">{copy.title}</span>
    <span class="gate-note">{copy.note}</span>
    <span class="gate-cta">{copy.reveal}</span>
  </span>
  <span class="gate-open">
    <Icon name="tabler:eye" class="h-3.5 w-3.5" />
    <span>{copy.hide}</span>
  </span>
</button>
