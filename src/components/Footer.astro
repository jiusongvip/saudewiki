---
import { SITE } from '../data/site';
import { ui } from '../i18n/ui';
import { contentFor } from '../lib/content';
import BrandLockup from './BrandLockup.astro';
import type { Locale } from '../types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;

const year = new Date().getFullYear();

const navigate = [
  { label: t.nav.diseases, href: urls.diseases() },
  { label: t.nav.articles, href: urls.articles() },
];

/**
 * `title` is the English name of the page, and it is the only thing rendered in
 * English here. The visible label stays in the reader's language, and it stays
 * the accessible name too: overriding it with `aria-label` would rename the
 * link for screen readers and break WCAG 2.5.3, which asks that the accessible
 * name contain the visible label.
 */
const institutional = [
  { label: t.footer.about, href: urls.about(), title: 'About' },
  { label: t.footer.editorial, href: urls.editorial(), title: 'Editorial Policy' },
  { label: t.footer.disclaimer, href: urls.medicalDisclaimer(), title: 'Medical Disclaimer' },
  { label: t.footer.privacy, href: urls.privacy(), title: 'Privacy Policy' },
  { label: t.footer.contact, href: urls.contact(), title: 'Contact' },
];
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="shell px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <BrandLockup />
        <p class="mt-4 max-w-sm text-[0.9rem] leading-relaxed text-ink-muted">{t.footer.blurb}</p>
      </div>

      <nav aria-label={t.footer.ariaNavigate}>
        <h2 class="eyebrow">{t.footer.navigate}</h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            navigate.map((item) => (
              <li>
                <a href={item.href} class="text-[0.9rem] text-ink-muted transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.footer.ariaInstitutional}>
        <h2 class="eyebrow">{t.footer.institutional}</h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            institutional.map((item) => (
              <li>
                <a
                  href={item.href}
                  title={item.title}
                  class="text-[0.9rem] text-ink-muted transition-colors hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="text-[0.8rem] leading-relaxed text-ink-muted">{t.site.legal}</p>
      <p class="mt-3 text-[0.8rem] text-ink-muted">
        © {year} {SITE.name}.
      </p>
    </div>
  </div>
</footer>
