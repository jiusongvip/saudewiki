---
import { ui } from '../i18n/ui';
import type { Locale } from '../types';

interface TocItem {
  id: string;
  heading: string;
}

interface Props {
  lang: Locale;
  items: TocItem[];
  title?: string;
}

const { lang, items, title = ui[lang].common.tocTitle } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label={title} class="rounded-xl border border-line bg-surface p-5">
      <h2 class="eyebrow">{title}</h2>
      <ol class="mt-4 flex flex-col gap-2">
        {items.map((item, index) => (
          <li class="flex gap-2.5 text-[0.85rem]">
            <span class="w-4 shrink-0 tabular-nums text-ink-muted">{index + 1}.</span>
            <a href={`#${item.id}`} class="text-ink-muted transition-colors hover:text-accent">
              {item.heading}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
