---
interface TocItem {
  id: string;
  heading: string;
}

interface Props {
  items: TocItem[];
  title?: string;
}

const { items, title = 'Nesta página' } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label={title} class="rounded-xl border border-line bg-surface p-5">
      <h2 class="overline">{title}</h2>
      <ol class="mt-4 flex flex-col gap-2">
        {items.map((item, index) => (
          <li class="flex gap-2.5 text-[0.85rem]">
            <span class="w-4 shrink-0 tabular-nums text-ink-muted">{index + 1}.</span>
            <a href={`#${item.id}`} class="text-ink-muted transition-colors hover:text-accent">
              {item.heading}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
