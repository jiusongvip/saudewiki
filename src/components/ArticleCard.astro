---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import { fill } from '../lib/i18n';
import { contentFor, formatDateFor } from '../lib/content';
import { imageForArticle } from '../lib/images';
import ImageSlot from './ImageSlot.astro';
import SensitiveImage from './SensitiveImage.astro';
import type { Article, Locale } from '../types';

interface Props {
  lang: Locale;
  article: Article;
  ratio?: string;
  eager?: boolean;
}

const { lang, article, ratio = '16 / 9', eager = false } = Astro.props;
const t = ui[lang];
const urls = contentFor(lang).urls;
const image = imageForArticle(article.slug, lang);
---

<!--
  Same shape as `DiseaseCard`: the link is stretched over the card instead of
  wrapping it, because the one photograph on the site taken in an operating room
  has to sit behind a cover, and that cover is a button.
-->
<article class="card card-link group relative flex flex-col overflow-hidden">
  {
    image?.sensitive && image.src ? (
      <SensitiveImage
        lang={lang}
        src={image.src}
        alt={image.alt}
        ratio={ratio}
        eager={eager}
      />
    ) : (
      <ImageSlot src={image?.src} alt={image?.alt ?? ''} ratio={ratio} eager={eager} />
    )
  }

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center gap-3">
      <span class="eyebrow">{article.category}</span>
      <span class="text-[0.72rem] text-ink-muted">{formatDateFor(article.updatedAt, lang)}</span>
    </div>

    <h3 class="mt-2.5 text-[1.15rem] font-semibold leading-snug tracking-tight">{article.title}</h3>

    <p class="mt-2 flex-1 text-[0.9rem] leading-relaxed text-ink-muted">{article.excerpt}</p>

    <span class="mt-5 inline-flex items-center gap-1.5 text-[0.85rem] font-semibold text-accent">
      {t.common.readArticle}
      <Icon
        name="tabler:arrow-right"
        class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
      />
    </span>
  </div>

  <a
    href={urls.article(article.slug)}
    class="card-hit"
    aria-label={fill(t.common.readArticleAria, { title: article.title })}
  ></a>
</article>
